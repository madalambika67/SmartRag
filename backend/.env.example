# Leave LLM_API_KEY / EMBED_API_KEY empty to run fully offline (local hashing embeddings + extractive answers).
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
CHEAP_MODEL=gpt-4o-mini
STRONG_MODEL=gpt-4o
# USD per 1M tokens (used for cost tracking)
CHEAP_IN=0.15
CHEAP_OUT=0.60
STRONG_IN=2.50
STRONG_OUT=10.00
EMBED_BASE_URL=https://api.openai.com/v1
EMBED_API_KEY=
EMBED_MODEL=text-embedding-3-small
DB_PATH=smartrag.db
